# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca envie o arquivo .env nem cole chaves no codigo ou no chat.
GEMINI_API_KEY="cole_sua_chave_do_google_ai_studio_aqui"
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Fallback textual NVIDIA: usado depois de todas as tentativas Gemini e antes de Laya/Ollama.
NVIDIA_API_KEY="cole_sua_chave_da_nvidia_aqui"
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_EFFORT=max
FFMPEG_TIMEOUT_SECONDS=3600
