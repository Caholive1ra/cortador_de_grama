# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca envie o arquivo .env nem cole chaves no codigo ou no chat.
GEMINI_API_KEY="cole_sua_chave_do_google_ai_studio_aqui"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Segundo revisor textual. Usa a mesma GEMINI_API_KEY, mas nao recebe audio.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Fallback textual NVIDIA: usado depois de todas as tentativas Gemini e antes de Laya/Ollama.
NVIDIA_API_KEY="cole_sua_chave_da_nvidia_aqui"
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Revisao editorial estruturada: mais rapido e suficiente para devolver JSON.
NVIDIA_REASONING_EFFORT=low
# A primeira chamada de cada modelo continua sem teto reduzido. Este limite vale
# somente caso ela falhe e uma segunda tentativa seja realmente necessaria.
TIMEOUT_SEGUNDA_TENTATIVA_SEGUNDOS=60
# FallBacks textuais recebem a aula em janelas para nao esgotar a resposta.
SEGUNDOS_POR_LOTE_TEXTUAL_COMPLETO=420
COOLDOWN_PROVEDOR_INDISPONIVEL_SEGUNDOS=600
# O teto por job conta chamadas de geracao remota, incluindo repeticoes
# transitorias. Com revisao por IA marcada, a esteira sempre tenta provedores
# remotos antes de usar o Ollama local.
LIMITE_CHAMADAS_REMOTAS_POR_JOB=4
# Resultados remotos concluidos podem ser reaproveitados pelo mesmo material.
EDITORIAL_CACHE_TTL_SECONDS=2592000
FFMPEG_TIMEOUT_SECONDS=3600
