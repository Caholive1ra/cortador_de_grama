{
  "manifestVersion": 5,
  "id": "com.decupagem.assistente",
  "name": "Assistente de Decupagem",
  "version": "0.1.4",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "painelDecupagem",
      "label": {
        "default": "Assistente de Decupagem"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 320
      },
      "preferredFloatingSize": {
        "width": 280,
        "height": 320
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  }
}
